{
  "name": "splitfire",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "splitfire": "./bin/splitfire.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "splitfire": "npx --yes tsx bin/splitfire.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@base-ui/react": "^1.9.0",
    "@upstash/redis": "^1.40.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^6.0.315",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.6.0",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tw-animate-css": "^1.4.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "graphology-types": "^0.24.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "splitfire": {
    "entry": "./bin/splitfire.ts",
    "runtime": "tsx",
    "pack": {
      "version": 1,
      "dir": ".splitfire",
      "files": {
        "overview": ".splitfire/README.md",
        "manifest": ".splitfire/plan.json",
        "task": ".splitfire/tasks/{label}-{id}.md"
      },
      "manifestSchema": {
        "id": "string - plan id: hash(repo, sha, request, agents, settingsVersion)",
        "repo": "string - owner/name",
        "sha": "string - full commit sha",
        "request": "string - the feature request",
        "tasks": "Task[] - see taskSchema",
        "collisionScore": "number - files with more than one owner; 0 after repair",
        "serialMinutes": "number",
        "parallelMinutes": "number",
        "speedup": "number",
        "agents": "number",
        "tokensFullRepo": "number",
        "tokensWithPacks": "number",
        "totalCostUsd": "number"
      },
      "taskSchema": {
        "id": "string",
        "title": "string",
        "goal": "string",
        "kind": "contract | feature | test | docs",
        "ownedFiles": "string[] - exclusive; one owner per file",
        "readFiles": "string[] - context only",
        "dependsOn": "string[] - task ids; must be acyclic",
        "difficulty": "1 | 2 | 3",
        "model": "string",
        "estTokens": "number",
        "estCostUsd": "number",
        "estMinutes": "number",
        "acceptance": "string[] - shell commands that prove the task is done"
      }
    },
    "commands": {
      "plan": {
        "usage": "npx splitfire plan \"<request>\"",
        "description": "Plan a GitHub repo and write the .splitfire pack.",
        "args": [
          {
            "name": "request",
            "type": "string",
            "required": true
          }
        ],
        "options": [
          {
            "name": "--repo",
            "type": "string",
            "description": "owner/name; defaults to the current directory's git remote"
          },
          {
            "name": "--agents",
            "type": "number",
            "default": 2
          },
          {
            "name": "--out",
            "type": "string",
            "default": ".splitfire"
          },
          {
            "name": "--mock",
            "type": "boolean",
            "default": false,
            "description": "Plan without model calls, using the deterministic planner"
          }
        ]
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
