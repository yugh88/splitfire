# Primary OpenAI-compatible open-model endpoint
OPENMODEL_BASE_URL=https://api.example.com/v1
OPENMODEL_API_KEY=replace-me
PLANNER_MODEL=strong-open-model-id
FAST_MODEL=small-open-model-id

# Fallback OpenAI-compatible endpoint
FALLBACK_BASE_URL=https://api.example-fallback.com/v1
FALLBACK_API_KEY=replace-me
FALLBACK_MODEL=fallback-open-model-id

# Credit limits (USD)
CREDIT_BUDGET_USD=5
PLAN_MAX_COST_USD=0.05
# USD per 1M tokens, keyed by model id
MODEL_PRICES_JSON={"strong-open-model-id":{"input":0.6,"output":2.4},"small-open-model-id":{"input":0.1,"output":0.4}}

# 1 = use fixture plans, no LLM calls (free UI development)
MOCK_LLM=1

# Upstash Redis (plan store, cache, rate limits, spend tracking)
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Optional: raises GitHub REST rate limit
GITHUB_TOKEN=
